            "Email_Cliente": "={{ $json.email_cliente }}",
            "Equipo_Industrial": "={{ $json.equipo }}",
            "Monto_Total_USD": "={{ $json.monto_total_usd }}",
            "Estado": "={{ $json.requiere_hitl ? 'Aprobado por Humano' : 'Auto-Aprobado' }}",
            "Resumen_IA": "={{ $json.propuesta_resumen }}"
          }
        }
      },
      "id": "node-7-airtable-save",
