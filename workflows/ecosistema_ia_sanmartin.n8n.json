        "jsCode": "// Parsear salida JSON de Ollama / LLM de forma segura\nconst content = $json.message?.content || '{}';\nlet aiData = {};\ntry {\n  aiData = typeof content === 'string' ? JSON.parse(content) : content;\n} catch (e) {\n  aiData = { monto_total_usd: 1500, requiere_aprobacion: false, propuesta_resumen: content };\n}\n\nconst inputData = $('2. ¿Datos Completos y Válidos?1').item.json.body || $('2. ¿Datos Completos y Válidos?1').item.json;\nconst monto = Number(aiData.monto_total_usd) || 0;\nconst necesitaHitl = monto > 3000 || aiData.requiere_aprobacion === true;\n\nreturn {\n  json: {\n    id_solicitud: 'COT-' + Math.floor(1000 + Math.random() * 9000),\n    nombre_cliente: inputData.nombre_cliente || 'Cliente Industrial',\n    email_cliente: inputData.email_cliente,\n    equipo: aiData.equipo || inputData.equipo_industrial || 'Lavadora de botellas',\n    monto_total_usd: monto,\n    score_lead: aiData.score_lead || 80,\n    categoria_lead: aiData.categoria_lead || 'Estándar',\n    requiere_hitl: necesitaHitl,\n    propuesta_resumen: aiData.propuesta_resumen || 'Cotización formal de repuestos originales Sanmartín.'\n  }\n};"
