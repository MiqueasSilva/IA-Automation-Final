    {
      "parameters": {
        "sendTo": "={{ $json.email_cliente }}",
        "subject": "=Cotización Oficial Sanmartín: {{ $json.equipo }} [Ref #{{ $json.id_solicitud }}]",
        "emailType": "html",
        "message": "<div style='font-family: Arial, sans-serif; max-width: 600px; padding: 20px; border: 1px solid #e2e8f0; border-radius: 8px;'>\n  <h2 style='color: #1e3a8a;'>Empresa Sanmartín S.A.</h2>\n  <p>Estimado/a <strong>{{ $json.nombre_cliente }}</strong>,</p>\n  <p>Hemos analizado su requerimiento técnico para el equipo <strong>{{ $json.equipo }}</strong>.</p>\n  <div style='background: #f1f5f9; padding: 15px; border-radius: 6px; margin: 15px 0;'>\n    <strong>Detalle de la Propuesta:</strong><br>\n    {{ $json.propuesta_resumen }}\n  </div>\n  <p style='font-size: 20px; font-weight: bold; color: #0f172a;'>Total Estimado: ${{ $json.monto_total_usd }} USD</p>\n  <p style='font-size: 12px; color: #64748b;'>Esta propuesta fue procesada y validada con nuestro sistema autónomo de cotizaciones.</p>\n</div>"
      },
      "id": "node-8-gmail",
      "name": "8. Gmail: Enviar Cotización al Cliente",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
